NODE_ENV=development
PORT=8080

# Use a JDBC URL. Managed MySQL providers usually require SSL in production.
DATABASE_URL=jdbc:mysql://localhost:3306/fooddelivery?useUnicode=true&characterEncoding=utf8&characterSetResults=utf8mb4&connectionCollation=utf8mb4_unicode_ci&useSSL=false&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=replace-with-local-password
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000

# Generate with: openssl rand -base64 32
JWT_PRIVATE_KEY=replace-with-base64-secret
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://food-delivery-project-chi-six.vercel.app
FILE_UPLOAD_ROOT=./uploads
